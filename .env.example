# Clave de Web3Forms para el formulario de contacto (https://web3forms.com).
# Se crea gratis con el correo de la parroquia; los mensajes llegan a ese correo.
# En Cloudflare Pages se pone en Settings → Variables and Secrets.
VITE_WEB3FORMS_KEY=

# CRM (Supabase): Project Settings → API. La "anon key" es pública por diseño;
# la seguridad la dan las reglas (RLS) de supabase/schema.sql.
# NUNCA poner aquí la "service_role key".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
